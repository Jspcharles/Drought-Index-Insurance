# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Generated outputs ---
# Everything below is regenerated by `python run_pipeline.py` in a few seconds,
# so only code and documentation are version-controlled. The .gitkeep files
# keep the empty folders in the repository.
data/raw/*
data/processed/*
results/*
figures/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
!figures/.gitkeep
